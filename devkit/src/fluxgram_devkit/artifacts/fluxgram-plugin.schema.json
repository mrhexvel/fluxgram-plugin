{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fluxgram.org/schemas/fluxgram-plugin.schema.json",
  "title": "FluxGram plugin project",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "plugin": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "version",
        "description",
        "author",
        "declared_capabilities"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^(?!fluxgram\\.)[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$",
          "maxLength": 100
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "version": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
          "maxLength": 64
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "author": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "min_sdk_minor": {
          "type": "integer",
          "minimum": 0,
          "maximum": 11
        },
        "declared_capabilities": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          }
        },
        "icon": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+(?:/[A-Za-z0-9_.-]+)*\\.(?:png|webp)$",
          "maxLength": 240
        }
      }
    },
    "python": {
      "type": "object",
      "additionalProperties": false,
      "required": ["root", "entrypoint", "files"],
      "properties": {
        "root": {
          "type": "string",
          "minLength": 1
        },
        "entrypoint": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*:PluginEntry$"
        },
        "files": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "java": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sources", "entrypoint", "min_api_minor"],
      "properties": {
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "entrypoint": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*(\\.[A-Za-z_][A-Za-z0-9_$]*)+$"
        },
        "min_api_minor": {
          "type": "integer",
          "minimum": 0,
          "maximum": 0
        },
        "host_stubs": {
          "type": "boolean",
          "default": false
        }
      }
    },
    "assets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["root", "files"],
      "properties": {
        "root": {
          "type": "string",
          "minLength": 1
        },
        "files": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  },
  "required": ["plugin"],
  "anyOf": [
    {"required": ["python"]},
    {"required": ["java"]}
  ],
  "allOf": [
    {
      "if": {"required": ["python"]},
      "then": {
        "properties": {
          "plugin": {"required": ["min_sdk_minor"]}
        }
      },
      "else": {
        "properties": {
          "plugin": {
            "not": {"required": ["min_sdk_minor"]}
          }
        }
      }
    }
  ]
}
